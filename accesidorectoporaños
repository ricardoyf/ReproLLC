#!/usr/bin/env bash
set -euo pipefail
REPROLLC_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if ! /usr/bin/python3 -c 'import gi; gi.require_version("Gtk", "3.0"); from gi.repository import Gtk' 2>/dev/null; then
    message="Faltan las dependencias de ReproLLC. Abre una terminal en el repositorio y ejecuta: ./instalar-ubuntu.sh"
    if command -v zenity >/dev/null; then
        zenity --error --title=ReproLLC --text="$message"
    else
        echo "$message" >&2
    fi
    exit 1
fi
exec /usr/bin/python3 "$REPROLLC_DIR/accesidorectoporaños.py" "$@"
